# ====================================
# LLM Prompt Management System
# 环境变量配置示例
# ====================================
#
# 使用说明：
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 根据需要修改下面的配置值
#
# 3. 重要：.env 文件包含敏感信息，已被 .gitignore 忽略
#    请勿将 .env 文件提交到 Git 仓库
#
# ====================================

# ----------------
# PostgreSQL 数据库配置
# ----------------

# 数据库用户名
POSTGRES_USER=myuser

# 数据库密码（生产环境请使用强密码）
POSTGRES_PASSWORD=mypassword123

# 数据库名称
POSTGRES_DB=ai_eng_db

# 数据库服务器地址
# Docker Compose 中使用服务名 'db'
# 本地开发可能需要使用 'localhost'
POSTGRES_SERVER=db

# 数据库端口
POSTGRES_PORT=5432

# ----------------
# 说明
# ----------------
#
# 数据库连接字符串将自动生成为：
# postgresql+psycopg2://myuser:mypassword123@db:5432/ai_eng_db
#
# 如果需要修改 API 服务端口，请编辑 docker-compose.yml
# 当前配置：主机端口 8002 -> 容器端口 8000

# ----------------
# LLM API Keys
# ----------------
# 生产环境请务必使用安全的密钥管理服务
# 用于演示，请在此处填写你的 OpenAI API Key
OPENAI_API_KEY="sk-..."